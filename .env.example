# Postgres connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mea

# Port the API listens on (Railway sets this automatically)
PORT=3000

# Long random string used to protect login sessions: openssl rand -hex 32
SESSION_SECRET=change-me

# Default timezone for day boundaries and the eating window
TZ_DEFAULT=Australia/Sydney

# Set to production on Railway
# NODE_ENV=production

# Web push keys (npm run vapid). Push notifications are off when these are unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
